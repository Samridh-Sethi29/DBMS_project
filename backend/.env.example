# ============================================================
# .env  –  Environment variables for club-event-api
# Copy to .env and fill in real values before starting.
# ============================================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=8h

# --- MySQL shared config ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=club_event_db

# --- Read pool  (role_naive user) ---
DB_READ_USER=user_naive
DB_READ_PASS=NaivePass#123

# --- Write pool  (role_developer user) ---
DB_WRITE_USER=user_developer
DB_WRITE_PASS=DevPass#456
